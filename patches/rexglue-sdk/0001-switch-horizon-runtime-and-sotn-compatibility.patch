+// only the main guest thread, and while paused performs just context capture plus the resume syscall
+// (no stack walk, allocation, logging or guest-memory access).
+constexpr u64 kGuestPcSampleIntervalNs = 4000000ULL;  // 4 ms / about 250 samples per second
+constexpr u64 kSegundoNs = 1000000000ULL;      // tick for the console overlays
+
+/* internal resolution published to the overlays. The game sets it when choosing the video mode. */
