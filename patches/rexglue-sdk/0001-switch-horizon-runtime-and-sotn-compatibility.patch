diff --git a/src/audio/switch/sdl_audio_shim.cpp b/src/audio/switch/sdl_audio_shim.cpp
new file mode 100644
index 0000000..4924022
--- /dev/null
+++ b/src/audio/switch/sdl_audio_shim.cpp
@@ -0,0 +1,178 @@
+/**
+ * @file        audio/switch/sdl_audio_shim.cpp
+ * @brief       SDL3 audio-stream subset for the WMA/raw PCM players on Switch.
+ *
+ * Each stream keeps its input as float stereo frames at the source rate and is
+ * resampled (linear) into the 48 kHz audout mix by MixShimStreams.
+ */
+#include <rex/audio/switch/sdl_audio_shim.h>
+
+#include <algorithm>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+struct SDL_AudioStream {
+  std::mutex mutex;
+  SDL_AudioSpec spec{};
+  float gain = 1.0f;
+  bool paused = true;
+  std::deque<float> frames;  // interleaved L/R at spec.freq
+  double position = 0.0;     // fractional read position into `frames` (in frames)
+};
+
+namespace {
+std::mutex g_streams_mutex;
+std::vector<SDL_AudioStream*> g_streams;
+
+int BytesPerSample(SDL_AudioFormat format) {
+  return format == SDL_AUDIO_S16LE ? 2 : 4;
+}
+}  // namespace
+
+bool SDL_InitSubSystem(SDL_InitFlags) {
+  return true;
+}
+void SDL_QuitSubSystem(SDL_InitFlags) {}
+const char* SDL_GetError() {
+  return "SDL audio shim (Switch)";
+}
+
+SDL_AudioStream* SDL_OpenAudioDeviceStream(SDL_AudioDeviceID, const SDL_AudioSpec* spec,
+                                           SDL_AudioStreamCallback, void*) {
+  if (!spec || spec->channels <= 0 || spec->freq <= 0) {
+    return nullptr;
+  }
+  auto* stream = new SDL_AudioStream();
+  stream->spec = *spec;
+  std::lock_guard<std::mutex> guard(g_streams_mutex);
+  g_streams.push_back(stream);
+  return stream;
+}
+
+bool SDL_SetAudioStreamGain(SDL_AudioStream* stream, float gain) {
+  if (!stream) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  stream->gain = gain;
+  return true;
+}
+
+bool SDL_ResumeAudioStreamDevice(SDL_AudioStream* stream) {
+  if (!stream) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  stream->paused = false;
+  return true;
+}
+
+bool SDL_PauseAudioStreamDevice(SDL_AudioStream* stream) {
+  if (!stream) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  stream->paused = true;
+  return true;
+}
+
+bool SDL_GetAudioStreamFormat(SDL_AudioStream* stream, SDL_AudioSpec* src_spec,
+                              SDL_AudioSpec* dst_spec) {
+  if (!stream) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  if (src_spec) *src_spec = stream->spec;
+  if (dst_spec) *dst_spec = SDL_AudioSpec{SDL_AUDIO_F32LE, 2, 48000};
+  return true;
+}
+
+bool SDL_SetAudioStreamFormat(SDL_AudioStream* stream, const SDL_AudioSpec* src_spec,
+                              const SDL_AudioSpec*) {
+  if (!stream) return false;
+  if (src_spec && src_spec->channels > 0 && src_spec->freq > 0) {
+    std::lock_guard<std::mutex> guard(stream->mutex);
+    stream->spec = *src_spec;
+  }
+  return true;
+}
+
+bool SDL_PutAudioStreamData(SDL_AudioStream* stream, const void* buf, int len) {
+  if (!stream || !buf || len <= 0) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  const int channels = stream->spec.channels;
+  const int bps = BytesPerSample(stream->spec.format);
+  const int count = len / (bps * channels);
+  for (int i = 0; i < count; ++i) {
+    float left = 0.0f, right = 0.0f;
+    for (int c = 0; c < std::min(channels, 2); ++c) {
+      float v;
+      if (bps == 2) {
+        v = static_cast<const int16_t*>(buf)[i * channels + c] / 32768.0f;
+      } else {
+        v = static_cast<const float*>(buf)[i * channels + c];
+      }
+      (c == 0 ? left : right) = v;
+    }
+    if (channels == 1) right = left;
+    stream->frames.push_back(left);
+    stream->frames.push_back(right);
+  }
+  return true;
+}
+
+int SDL_GetAudioStreamQueued(SDL_AudioStream* stream) {
+  if (!stream) return -1;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  const size_t queued_frames = stream->frames.size() / 2;
+  return static_cast<int>(queued_frames * stream->spec.channels *
+                          BytesPerSample(stream->spec.format));
+}
+
+bool SDL_FlushAudioStream(SDL_AudioStream* stream) {
+  return stream != nullptr;
+}
+
+bool SDL_ClearAudioStream(SDL_AudioStream* stream) {
+  if (!stream) return false;
+  std::lock_guard<std::mutex> guard(stream->mutex);
+  stream->frames.clear();
+  stream->position = 0.0;
+  return true;
+}
+
+void SDL_DestroyAudioStream(SDL_AudioStream* stream) {
+  if (!stream) return;
+  {
+    std::lock_guard<std::mutex> guard(g_streams_mutex);
+    g_streams.erase(std::remove(g_streams.begin(), g_streams.end(), stream), g_streams.end());
+  }
+  delete stream;
+}
+
+namespace rex::audio::nx {
+
+void MixShimStreams(float* stereo, uint32_t frames) {
+  std::lock_guard<std::mutex> guard(g_streams_mutex);
+  for (SDL_AudioStream* stream : g_streams) {
+    std::lock_guard<std::mutex> stream_guard(stream->mutex);
+    if (stream->paused || stream->frames.size() < 4) {
+      continue;
+    }
+    const double step = double(stream->spec.freq) / 48000.0;
+    double pos = stream->position;
+    const float gain = stream->gain;
+    for (uint32_t i = 0; i < frames; ++i) {
+      size_t index = static_cast<size_t>(pos);
+      if ((index + 1) * 2 + 1 >= stream->frames.size()) {
+        break;  // underrun: the rest of this buffer stays silent for this stream
+      }
+      const float t = static_cast<float>(pos - double(index));
+      const float l = stream->frames[index * 2] * (1.0f - t) + stream->frames[index * 2 + 2] * t;
+      const float r =
+          stream->frames[index * 2 + 1] * (1.0f - t) + stream->frames[index * 2 + 3] * t;
+      stereo[i * 2] += l * gain;
+      stereo[i * 2 + 1] += r * gain;
+      pos += step;
+    }
+    const size_t consumed = static_cast<size_t>(pos);
+    stream->frames.erase(stream->frames.begin(),
+                         stream->frames.begin() + std::min(consumed * 2, stream->frames.size()));
+    stream->position = pos - double(consumed);
+  }
+}
+
+}  // namespace rex::audio::nx
