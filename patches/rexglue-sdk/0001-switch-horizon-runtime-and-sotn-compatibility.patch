+  const size_t guest_resume_retries = g_guest_pc_resume_retries;
+  const size_t guest_target_gone = g_guest_pc_target_gone;
+  const size_t guest_target_missing = g_guest_pc_target_missing;
+  const size_t guest_dropped = g_guest_pc_dropped;
+  g_guest_pc_invalid = 0;
+  g_guest_pc_not_registered = 0;
+  g_guest_pc_already_suspended = 0;
