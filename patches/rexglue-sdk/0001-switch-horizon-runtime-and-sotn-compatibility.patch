+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_nvMapCreate(m, cpu_addr, size, align, kind, is_cpu_cacheable);
+  Anotar(is_cpu_cacheable ? kNvMapCacheada : kNvMapSinCache, desde, size);
